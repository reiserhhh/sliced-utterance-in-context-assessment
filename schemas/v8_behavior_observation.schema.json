{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suica.v8.behavior_observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "events", "abstain"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "segment_id",
                "event_code",
                "evidence_span_ids"
              ],
              "properties": {
                "event_id": {"type": "string", "minLength": 1},
                "segment_id": {"type": "string", "minLength": 1},
                "event_code": {
                  "enum": [
                    "discourse_stance",
                    "affect_expression",
                    "self_reference",
                    "directive_expression",
                    "novelty_expression",
                    "interaction_response"
                  ]
                },
                "evidence_span_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "abstain": {"type": "boolean"}
        }
      }
    }
  }
}
