{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suica.v8.behavior_observation.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "segments"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "opportunities",
                "events",
                "abstain"
              ],
              "properties": {
                "segment_id": {"type": "string", "minLength": 1},
                "opportunities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["opportunity_code", "evidence_span_ids"],
                    "properties": {
                      "opportunity_code": {
                        "enum": [
                          "stance_opportunity",
                          "affect_opportunity",
                          "self_report_opportunity",
                          "action_guidance_opportunity",
                          "generativity_opportunity",
                          "self_repair_opportunity"
                        ]
                      },
                      "evidence_span_ids": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event_id",
                      "event_code",
                      "evidence_span_ids",
                      "antecedent_span_ids",
                      "relation_type"
                    ],
                    "properties": {
                      "event_id": {"type": "string", "minLength": 1},
                      "event_code": {
                        "enum": [
                          "assertion_commitment",
                          "epistemic_qualification",
                          "explicit_acceptance",
                          "explicit_rejection",
                          "positive_affect_expression",
                          "negative_affect_expression",
                          "self_state_report",
                          "self_action_report",
                          "request_action",
                          "recommend_action",
                          "alternative_generation",
                          "causal_explanation",
                          "evidence_example",
                          "self_repair"
                        ]
                      },
                      "evidence_span_ids": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}
                      },
                      "antecedent_span_ids": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1}
                      },
                      "relation_type": {
                        "enum": ["none", "self_revision"]
                      }
                    }
                  }
                },
                "abstain": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
