{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suica.v8.interpretation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
            "profile_id",
            "assessment_status",
            "interpretation_atoms",
            "refusal_codes"
        ],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "assessment_status": {
            "enum": ["interpreted", "insufficient_support"]
          },
          "interpretation_atoms": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "atom_id",
                "target_dimension_ids",
                "scope",
                "relation",
                "direction",
                "support_level",
                "qualifier",
                "evidence_event_ids",
                "counterevidence_event_ids",
                "alternative_codes",
                "renderer_template_id",
                "human_readable_sentence"
              ],
              "properties": {
                "atom_id": {"type": "string", "minLength": 1},
                "target_dimension_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^D[0-9]{3}$"}
                },
                "scope": {
                  "enum": [
                    "author_relative",
                    "session_bounded",
                    "condition_specific",
                    "interaction"
                  ]
                },
                "relation": {
                  "enum": [
                    "elevated",
                    "reduced",
                    "variable",
                    "coupled",
                    "conflicted",
                    "indeterminate"
                  ]
                },
                "direction": {
                  "enum": [
                    "positive",
                    "negative",
                    "mixed",
                    "not_applicable"
                  ]
                },
                "support_level": {
                  "enum": ["weak", "moderate", "strong"]
                },
                "qualifier": {
                  "enum": ["supported", "qualified", "insufficient"]
                },
                "evidence_event_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "counterevidence_event_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "alternative_codes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "condition_opportunity",
                      "transient_state",
                      "topic_selection",
                      "format_or_length",
                      "insufficient_repetition"
                    ]
                  }
                },
                "renderer_template_id": {
                  "enum": [
                    "technical_reference_difference_v1",
                    "exploratory_text_behavior_v1"
                  ]
                },
                "human_readable_sentence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              }
            }
          },
          "refusal_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "insufficient_evidence",
                "unsupported_personality_label",
                "unsupported_diagnosis",
                "out_of_support",
                "conflicting_evidence",
                "unstable_interpretation"
              ]
            }
          }
        }
      }
    }
  }
}
